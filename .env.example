# MySQL
DATABASE_URL=mysql://root:password@127.0.0.1:3306/racana_reservation

# Application and authentication
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Transactional email. Set EMAIL_SANDBOX_TO during Resend sandbox testing.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Racana Reservations <onboarding@resend.dev>
EMAIL_SANDBOX_TO=

# Initial owner bootstrap (only needed while running `bun run admin:bootstrap`)
BOOTSTRAP_OWNER_EMAIL=rizkyarfians27@gmail.com
BOOTSTRAP_OWNER_NAME=Rizky Arfians
BOOTSTRAP_OWNER_PASSWORD=

# Business rules
BUSINESS_TIMEZONE=Asia/Jakarta
BUSINESS_OPEN_TIME=10:00
BUSINESS_CLOSE_TIME=22:00
SLOT_INTERVAL_MINUTES=30
MAX_CAPACITY=50
MIN_BOOKING_LEAD_HOURS=2
MAX_BOOKING_DAYS=90
